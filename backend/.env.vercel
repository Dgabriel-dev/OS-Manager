# Vercel Environment Variables Template
# Copie estas variaveis para o painel do Vercel

APP_NAME="OS Assist"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://os-manager-backend.vercel.app

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_LEVEL=warning

# PostgreSQL externo (Supabase, Neon, etc)
DB_CONNECTION=pgsql
DB_HOST=your-db-host.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=your-db-user
DB_PASSWORD=your-db-password

# Sem Redis no Vercel - usar database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=os_cache

MAIL_MAILER=log
MAIL_HOST=null
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@osassist.com.br"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
VITE_API_URL=https://os-manager-backend.vercel.app/api

SANCTUM_STATEFUL_DOMAINS=os-manager-*.vercel.app

AUDITING_ENABLED=true
